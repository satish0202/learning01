# Copy this file to .env and fill in the keys you have, then restart the server.
# (Variables exported in your shell take priority over this file.)

# Free real fares from Aviasales (last 48 hours). Get the token at
# https://www.travelpayouts.com -> Profile -> API token.
TRAVELPAYOUTS_TOKEN=

# Optional: live Google Flights via SerpApi, 250 free searches a month.
# Get the key at https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Optional: Duffel API token (test mode returns sandbox data only).
DUFFEL_ACCESS_TOKEN=

# Path of the local SQLite database file.
FLIGHT_DB_PATH=flights.db
